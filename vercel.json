{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "npm run build",
  "outputDirectory": null,
  "crons": [
    {
      "path": "/api/internal/customer-jobs",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/customer-account-cleanup",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/internal/gift-card-jobs",
      "schedule": "15 8 * * *"
    }
  ]
}
