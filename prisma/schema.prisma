generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  legacyId        Int?      @unique
  slug            String    @unique
  name            String
  originalName    String
  headline        String    @default("")
  intro           String    @default("")
  pack            String
  material        String
  currency        String    @default("EUR")
  image           String
  active          Boolean   @default(true)
  variants        Variant[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@map("products")
}

model Variant {
  id             String     @id @default(uuid()) @db.Uuid
  legacyId       Int?       @unique
  productId      String     @db.Uuid
  product        Product    @relation(fields:[productId],references:[id],onDelete:Restrict)
  colorCode      String
  colorLabel     String
  lengthCode     String
  lengthLabel    String
  priceCents     Int
  stockQuantity  Int?       // null means original stock count is unverified
  image          String
  active         Boolean    @default(true)
  orderLines     OrderLine[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@unique([productId,colorCode,lengthCode])
  @@index([productId,active])
  @@map("variants")
}

model Order {
  id                String         @id @default(uuid()) @db.Uuid
  orderNumber       BigInt         @unique @default(autoincrement())
  status            String         @default("draft")
  currency          String         @default("EUR")
  subtotalCents     Int            @default(0)
  shippingCents     Int            @default(0)
  taxCents          Int            @default(0)
  totalCents        Int            @default(0)
  customerEmail     String?
  billingAddress    Json?
  shippingAddress   Json?
  paymentReference  String?        @unique
  trackingCarrier   String?
  trackingNumber    String?
  fulfillmentNote   String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  testOnly          Boolean        @default(false)
  reservationKey    String?        @unique
  requestDigest     String?
  reservationExpiresAt DateTime?
  lines             OrderLine[]
  payments          PaymentEvent[]
  statusEvents      OrderStatusEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@index([status,createdAt(sort: Desc)])
  @@index([testOnly,status,reservationExpiresAt])
  @@map("orders")
}

model OrderLine {
  id              String     @id @default(uuid()) @db.Uuid
  orderId         String     @db.Uuid
  order           Order      @relation(fields:[orderId],references:[id],onDelete:Restrict)
  variantId       String     @db.Uuid
  variant         Variant    @relation(fields:[variantId],references:[id],onDelete:Restrict)
  quantity        Int
  unitPriceCents  Int
  lineTotalCents  Int
  @@map("order_lines")
}

model PaymentEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @db.Uuid
  order               Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  provider            String
  providerEventId     String   @unique
  eventType           String
  receivedAt          DateTime @default(now())
  @@map("payment_events")
}

model OrderStatusEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  fromStatus  String?
  toStatus    String
  reason      String
  createdAt   DateTime @default(now())
  @@index([orderId,createdAt])
  @@map("order_status_events")
}

model AdminLoginAttempt {
  key           String   @id
  count         Int      @default(0)
  windowStart   DateTime @default(now())
  @@map("admin_login_attempts")
}

// Consent-gated, anonymous aggregate event counts. No user/session IDs, IPs or addresses.
model AnalyticsAggregate {
  id      String   @id @default(uuid()) @db.Uuid
  day     DateTime @db.Date
  path    String
  event   String
  source  String
  device  String
  count   Int      @default(0)
  @@unique([day,path,event,source,device])
  @@index([day,event])
  @@map("analytics_aggregates")
}
