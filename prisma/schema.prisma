generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  legacyId        Int?      @unique
  slug            String    @unique
  name            String
  originalName    String
  headline        String    @default("")
  intro           String    @default("")
  pack            String
  material        String
  currency        String    @default("EUR")
  image           String
  active          Boolean   @default(true)
  variants        Variant[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@map("products")
}

model Variant {
  id             String     @id @default(uuid()) @db.Uuid
  legacyId       Int?       @unique
  productId      String     @db.Uuid
  product        Product    @relation(fields:[productId],references:[id],onDelete:Restrict)
  colorCode      String
  colorLabel     String
  lengthCode     String
  lengthLabel    String
  priceCents     Int
  stockQuantity  Int?       // null means original stock count is unverified
  image          String
  active         Boolean    @default(true)
  orderLines     OrderLine[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@unique([productId,colorCode,lengthCode])
  @@index([productId,active])
  @@map("variants")
}

model Order {
  id                String         @id @default(uuid()) @db.Uuid
  orderNumber       BigInt         @unique @default(autoincrement())
  status            String         @default("draft")
  currency          String         @default("EUR")
  subtotalCents     Int            @default(0)
  shippingCents     Int            @default(0)
  taxCents          Int            @default(0)
  totalCents        Int            @default(0)
  giftAppliedCents  Int            @default(0)
  customerEmail     String?
  billingAddress    Json?
  shippingAddress   Json?
  paymentReference  String?        @unique
  trackingCarrier   String?
  trackingNumber    String?
  fulfillmentNote   String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  testOnly          Boolean        @default(false)
  reservationKey    String?        @unique
  requestDigest     String?
  reservationExpiresAt DateTime?
  lines             OrderLine[]
  payments          PaymentEvent[]
  statusEvents      OrderStatusEvent[]
  invoice           Invoice?
  notifications     OrderNotification[]
  shippingJob       ShippingJob?
  giftPurchases    GiftPurchase[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@index([status,createdAt(sort: Desc)])
  @@index([testOnly,status,reservationExpiresAt])
  @@map("orders")
}

model OrderLine {
  id              String     @id @default(uuid()) @db.Uuid
  orderId         String     @db.Uuid
  order           Order      @relation(fields:[orderId],references:[id],onDelete:Restrict)
  variantId       String     @db.Uuid
  variant         Variant    @relation(fields:[variantId],references:[id],onDelete:Restrict)
  quantity        Int
  unitPriceCents  Int
  lineTotalCents  Int
  stockReserved   Boolean @default(false)
  @@map("order_lines")
}

model PaymentEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @db.Uuid
  order               Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  provider            String
  providerEventId     String   @unique
  eventType           String
  receivedAt          DateTime @default(now())
  @@map("payment_events")
}

model OrderStatusEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  fromStatus  String?
  toStatus    String
  reason      String
  createdAt   DateTime @default(now())
  @@index([orderId,createdAt])
  @@map("order_status_events")
}

model AdminLoginAttempt {
  key           String   @id
  count         Int      @default(0)
  windowStart   DateTime @default(now())
  @@map("admin_login_attempts")
}

// Consent-gated, anonymous aggregate event counts. No user/session IDs, IPs or addresses.
model AnalyticsAggregate {
  id      String   @id @default(uuid()) @db.Uuid
  day     DateTime @db.Date
  path    String
  event   String
  source  String
  device  String
  count   Int      @default(0)
  @@unique([day,path,event,source,device])
  @@index([day,event])
  @@map("analytics_aggregates")
}


// Encrypted credentials for separately approved payment providers. No plaintext keys in DB.
model PaymentIntegrationSetting {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  environment String
  field      String
  ciphertext String
  nonce      String
  authTag    String
  updatedAt  DateTime @updatedAt
  @@unique([provider, environment, field])
  @@index([provider, environment])
  @@map("payment_integration_settings")
}

// Immutable PDF invoice issued only after strict payment-provider reconciliation.
// The original internal QA invoice and regular customer invoice share this model.
model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  order         Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  seller        Json
  buyer         Json
  lines         Json
  taxRate       Int
  taxCents      Int
  totalCents    Int
  pdf           Bytes    @db.ByteA
  @@map("invoices")
}

// Payment-confirmed, durable, idempotent email delivery queue.
model OrderNotification {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  order         Order    @relation(fields:[orderId],references:[id],onDelete:Restrict)
  stage         String
  status        String   @default("queued")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([orderId,stage])
  @@index([status,nextAttemptAt])
  @@map("order_notifications")
}

// A consumer withdrawal request is recorded regardless of order/payment state.
// Acknowledgment delivery is tracked separately; the request itself is never discarded.
model WithdrawalRequest {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(120)
  contract        String   @db.VarChar(160)
  email           String   @db.VarChar(254)
  emailDigest     String   @db.VarChar(64)
  ipDigest        String?  @db.VarChar(64)
  receivedAt      DateTime @default(now())
  status          String   @default("pending")
  acknowledgedAt  DateTime?
  attempts        Int      @default(0)
  nextAttemptAt   DateTime @default(now())
  @@index([emailDigest,receivedAt])
  @@index([ipDigest,receivedAt])
  @@index([status,nextAttemptAt])
  @@map("withdrawal_requests")
}

// One shipment per customer order; shipping labels are never created for QA.
model ShippingJob {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @unique @db.Uuid
  order          Order     @relation(fields:[orderId],references:[id],onDelete:Restrict)
  status         String    @default("waiting_credentials")
  attemptCount   Int       @default(0)
  lastError      String?
  trackingNumber String?
  labelPdf       Bytes?    @db.ByteA
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([status,updatedAt])
  @@map("shipping_jobs")
}

// Anonymized, bounded AI usage accounting; no photo, prompt or customer
// identifier is retained. A short-lived active flag limits concurrent spend.
model TryonQuotaAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  ipDigest    String   @db.VarChar(64)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  finishedAt  DateTime?
  @@index([ipDigest,createdAt])
  @@index([createdAt])
  @@index([finishedAt,expiresAt])
  @@map("tryon_quota_attempts")
}

// Optional, email-verified customer accounts. Orders stay guest-compatible.
model CustomerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @unique @db.VarChar(254)
  verifiedAt  DateTime          @default(now())
  lastLoginAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  firstName   String?           @db.VarChar(80)
  lastName    String?           @db.VarChar(80)
  passwordHash String?          @db.VarChar(255)
  sessions    CustomerSession[]
  addresses   CustomerAddress[]

  @@map("customer_accounts")
}

model CustomerLoginToken {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @db.VarChar(254)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("customer_login_tokens")
}

model CustomerSession {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @db.Uuid
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String          @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([accountId, expiresAt])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerAuthRateLimit {
  key         String   @id @db.Char(64)
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("customer_auth_rate_limits")
}

model CustomerAddress {
  id         String          @id @default(uuid()) @db.Uuid
  accountId  String          @db.Uuid
  account    CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label      String          @db.VarChar(40)
  firstName  String          @db.VarChar(80)
  lastName   String          @db.VarChar(80)
  street     String          @db.VarChar(160)
  postalCode String          @db.VarChar(5)
  city       String          @db.VarChar(100)
  country    String          @default("DE") @db.VarChar(2)
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([accountId, createdAt])
  @@map("customer_addresses")
}

// Digital gift cards are a separate non-shipping payment workflow.
// No code or redeemable credit exists until verified PayPal capture.
model GiftPurchase {
  id                  String    @id @default(uuid()) @db.Uuid
  requestKey          String    @unique @db.Uuid
  requestHash         String    @db.Char(64)
  amountCents         Int
  buyerEmail          String    @db.VarChar(254)
  recipientEmail      String?   @db.VarChar(254)
  recipientName       String    @db.VarChar(80)
  senderName          String?   @db.VarChar(80)
  message             String?   @db.VarChar(180)
  theme               String    @default("classic") @db.VarChar(20)
  delivery            String    @default("download") @db.VarChar(20)
  status              String    @default("pending") @db.VarChar(30)
  provider            String    @default("paypal") @db.VarChar(20)
  providerOrderId     String?   @unique @db.VarChar(90)
  providerCaptureId   String?   @unique @db.VarChar(100)
  cartOrderId         String?   @db.Uuid
  cartOrder           Order?    @relation(fields: [cartOrderId], references: [id], onDelete: Restrict)
  capturedAt          DateTime?
  buyerMailStatus     String    @default("queued") @db.VarChar(20)
  recipientMailStatus String    @default("queued") @db.VarChar(20)
  buyerMailSentAt     DateTime?
  recipientMailSentAt DateTime?
  mailAttempts        Int       @default(0)
  nextMailAttempt     DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  card                GiftCard?

  @@index([status, createdAt])
  @@index([cartOrderId])
  @@index([buyerMailStatus, nextMailAttempt])
  @@map("gift_purchases")
}

model GiftCard {
  id             String           @id @default(uuid()) @db.Uuid
  purchaseId     String           @unique @db.Uuid
  purchase       GiftPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  codeHash       String           @unique @db.Char(64)
  codeCiphertext String
  codeIv         String
  codeTag        String
  faceCents      Int
  balanceCents   Int
  status         String           @default("active") @db.VarChar(20)
  issuedAt       DateTime         @default(now())
  redemptions    GiftRedemption[]

  @@index([status, issuedAt])
  @@map("gift_cards")
}

model GiftRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  cardId      String    @db.Uuid
  card        GiftCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  orderId     String    @unique @db.Uuid
  amountCents Int
  state       String    @default("reserved") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  @@index([cardId, state])
  @@map("gift_redemptions")
}

// Operational checkout errors only: no submitted form values or payment credentials.
model CheckoutDiagnostic {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  method    String
  stage     String
  code      String
  origin    String
  orderId   String?  @db.Uuid
  @@index([createdAt])
  @@index([orderId,createdAt])
  @@map("checkout_diagnostics")
}
