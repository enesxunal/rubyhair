# Dedicated Ruby Hair PostgreSQL database. Use SSL for remote connections.
DATABASE_URL=
# Single admin account, no default password or public registration.
ADMIN_EMAIL=
# bcrypt hash only; generate locally via npm run admin:hash (reads from stdin).
ADMIN_PASSWORD_HASH=
# Random secret >=32 characters, unique per deployment.
SESSION_SECRET=
# Closed AI hair preview test only. Both values required for API generation.
# Use an OpenAI API key with image edit permission and billing configured.
OPENAI_API_KEY=
# Separate private test access code >=12 characters; never expose to public.
RUBY_TRYON_TEST_CODE=
# No payment processing until properly integrated.
PAYMENT_PROVIDER_SECRET=
