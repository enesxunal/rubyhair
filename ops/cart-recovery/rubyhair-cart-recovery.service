[Unit]
Description=Ruby Hair consented cart reminders
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/curl --config /etc/rubyhair/cart-recovery.curl --fail --silent --show-error --max-time 65 https://rubyhair.de/api/internal/cart-recovery
TimeoutStartSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
