{
  "name": "ruby-hair-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8765",
    "build": "prisma generate && next build",
    "start": "next start -p 8765",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/next-architecture.test.cjs && tsx --test tests/tryon-photo-suitability.test.ts tests/admin-password-config.test.ts",
    "test:orders": "RUBY_LOCAL_ORDER_TESTS=LOCAL_TEST_ONLY tsx scripts/test-order-reservation.ts",
    "orders:expire:local": "RUBY_LOCAL_ORDER_TESTS=LOCAL_TEST_ONLY tsx scripts/local-order-expiry-worker.ts --once",
    "orders:worker:local": "RUBY_LOCAL_ORDER_TESTS=LOCAL_TEST_ONLY tsx scripts/local-order-expiry-worker.ts --watch",
    "orders:audit:local": "RUBY_LOCAL_ORDER_TESTS=LOCAL_TEST_ONLY tsx scripts/audit-local-orders.ts",
    "orders:fixtures:clean": "RUBY_LOCAL_ORDER_TESTS=LOCAL_TEST_ONLY tsx scripts/cleanup-local-test-fixtures.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:hash": "node scripts/hash-admin-password.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
